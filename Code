<!DOCTYPE html>
<html>
<head>
    <title>Student Registration Form</title>
</head>
<body>

<?php

$name = $email = $gender = $course = $message = "";
$hobbies = [];
$error = "";

if ($_SERVER["REQUEST_METHOD"] == "POST") {

    $name = htmlspecialchars($_POST["name"]);
    $email = htmlspecialchars($_POST["email"]);
    $gender = htmlspecialchars($_POST["gender"]);
    $course = htmlspecialchars($_POST["course"]);
    $message = htmlspecialchars($_POST["message"]);

    if(isset($_POST["hobbies"])) {
        $hobbies = $_POST["hobbies"];
    }

    // Validation
    if (empty($name) || empty($email) || empty($gender) || empty($course)) {
        $error = "Please fill in all required fields.";
    } 
    elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $error = "Invalid email format.";
    }
}
?>

<h2>Student Registration Form</h2>

<form method="post" action="<?php echo htmlspecialchars($_SERVER["PHP_SELF"]); ?>">

    Name:
    <input type="text" name="name" value="<?php echo $name; ?>" required>
    <br><br>

    Email:
    <input type="email" name="email" value="<?php echo $email; ?>" required>
    <br><br>

    Gender:
    <input type="radio" name="gender" value="Male"
    <?php if($gender == "Male") echo "checked"; ?>> Male

    <input type="radio" name="gender" value="Female"
    <?php if($gender == "Female") echo "checked"; ?>> Female
    <br><br>

    Course:
    <select name="course" required>
        <option value="">-- Select Course --</option>

        <option value="BSIT"
        <?php if($course == "BSIT") echo "selected"; ?>>
        BSIT
        </option>

        <option value="BSCS"
        <?php if($course == "BSCS") echo "selected"; ?>>
        BSCS
        </option>

        <option value="BSA"
        <?php if($course == "BSA") echo "selected"; ?>>
        BSA
        </option>
    </select>

    <br><br>

    Hobbies:
    <input type="checkbox" name="hobbies[]" value="Reading"> Reading
    <input type="checkbox" name="hobbies[]" value="Gaming"> Gaming
    <input type="checkbox" name="hobbies[]" value="Sports"> Sports

    <br><br>

    Message:
    <br>
    <textarea name="message" rows="5" cols="30"><?php echo $message; ?></textarea>

    <br><br>

    <input type="submit" value="Register">
    <input type="reset" value="Reset">

</form>

<hr>

<?php

if ($error != "") {

    echo "<h3 style='color:red;'>$error</h3>";

} 
elseif ($_SERVER["REQUEST_METHOD"] == "POST") {

    echo "<h2>Registration Details</h2>";

    echo "<b>Name:</b> $name <br>";
    echo "<b>Email:</b> $email <br>";
    echo "<b>Gender:</b> $gender <br>";
    echo "<b>Course:</b> $course <br>";

    if (!empty($hobbies)) {
        echo "<b>Hobbies:</b> " . implode(", ", $hobbies) . "<br>";
    } else {
        echo "<b>Hobbies:</b> None<br>";
    }

    echo "<b>Message:</b> $message";
}
?>

</body>
</html>
